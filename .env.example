# YouKnowMe local configuration.

# Tests and local demos use fake embeddings by default.
YKM_EMBEDDING_PROVIDER=fake

# Real embeddings use OpenRouter. Keep the key in your private .env, never in Git.
# YKM_EMBEDDING_PROVIDER=openrouter
YKM_EMBEDDING_MODEL=openai/text-embedding-3-small
YKM_EMBEDDING_DIMENSIONS=1536
OPENROUTER_API_KEY=

# Runtime paths.
YKM_INDEX_PATH=.ykm/demo-index
YKM_LOG_PATH=.ykm/query-log.jsonl
YKM_LOG_RETENTION_DAYS=90

# Public Cloudflare path.
YKM_OWNER_EMAIL=
YKM_CLOUDFLARE_TEAM_DOMAIN=
YKM_CLOUDFLARE_AUD=

# Local/Hermes private path.
YKM_LOCAL_AUTH_SECRET=

